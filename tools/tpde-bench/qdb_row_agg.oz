(block
  (pragma language overloads)
  (use qumirdb)
  ;; Group-by on the row table of qdb (row_table.oz): batches of hashes go
  ;; through rt_seek_all, then every row is resolved with rt_seek, appended to
  ;; the arena when its key is new or summed into its row otherwise.
  ;; Rows: hash, key, sum (24 bytes).
  (fun <main> ()
    (block
      (var arena = (cast (struct ((Rows 0))) RowArena))
      (var table = (cast (struct ((Rows 0))) RowTable))
      (var scratch = (cast (struct ((Capacity 0))) RowScratch))
      (call ra_init arena 24 4096)
      (var ok = (call rt_init table 65536))
      (var batch = 1024)
      (= ok (&& ok (call rt_scratch_reserve scratch batch 8)))
      (var n = 2000000)
      (var seed = (: 12345 u64))
      (var start = 0)
      (while (< start n)
        (block
          (var count = batch)
          (if (> (+ start count) n) (block (= count (- n start))))
          (var hashes = (field scratch Hashes))
          (var bkeys = (cast (field scratch Keys) <ptr i64>))
          (var j = 0)
          (while (< j count)
            (block
              (= seed (+ (* seed (: 6364136223846793005 u64)) (: 1442695040888963407 u64)))
              (var key = (cast (% (>> seed (: 33 u64)) (: 40000 u64)) i64))
              (= bkeys [j] key)
              (= hashes [j] (cast (call aggregation_i64_hash key) u64))
              (= j (+ j 1))))
          (call rt_seek_all table scratch count)
          (var salts = (field scratch Salts))
          (var offsets = (field scratch Offsets))
          (var mask = (field table Mask))
          (= j 0)
          (while (< j count)
            (block
              (var key = (index bkeys j))
              (var salt = (index salts j))
              (var off = (index offsets j))
              (var value = (& (+ start j) 1023))
              (var e = (call rt_seek table off salt off))
              (var done = #f)
              (while (! done)
                (block
                  (if (== e (: 0 u64))
                    (block
                      (var row = (cast (call ra_new_row arena) <ptr i64>))
                      (= row [0] (cast (index hashes j) i64))
                      (= row [1] key)
                      (= row [2] value)
                      (var entries = (field table Entries))
                      (= entries [(cast off i64)] (call rt_entry salt (cast row <ptr u8>)))
                      (field_assign table Keys (+ (field table Keys) 1))
                      (= done #t))
                    (block
                      (var row = (cast (call rt_entry_row e) <ptr i64>))
                      (if (== (index row 1) key)
                        (block
                          (= row [2] (+ (index row 2) value))
                          (= done #t))
                        (block
                          (= off (& (+ off (: 1 u64)) mask))
                          (= e (call rt_seek table off salt off))))))))
              (= j (+ j 1))))
          (= start (+ start count))))
      (var b = 0)
      (var end = 0)
      (var check = 0)
      (var rows = 0)
      (var row = (call ra_first_row arena b end))
      (while (!= (cast row i64) 0)
        (block
          (var w = (cast row <ptr i64>))
          (= check (+ check (* (index w 1) (index w 2))))
          (= rows (+ rows 1))
          (= row (call ra_next_row arena b end row))))
      (output ok " " rows " " (field table Keys) " " check "\n")
      (call rt_scratch_destroy scratch)
      (call rt_destroy table)
      (call ra_destroy arena))))
