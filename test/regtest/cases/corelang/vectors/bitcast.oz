(block
  (use Vector)
  (fun <main> ()
    (block
      (var pair = (: (vec 1 2) <vec i32 2>))
      (var packed = (bitcast pair i64))
      (output packed " " (bitcast packed <vec i32 2>) "\n")
      (output (bitcast (: (vec 0 0 0 0 0 0 248 63) <vec u8 8>) f64) "\n")
      (var fraction = -1.5)
      (output (bitcast fraction <vec u8 8>) " " (bitcast fraction <vec i32 2>) "\n")
      (output (bitcast 4294967298 <vec i32 2>) " " (bitcast 1.5 <vec u16 4>) "\n")
      (var bytes = (: (vec 255 255 255 255) <vec u8 4>))
      (output (cast (bitcast bytes i32) i64) " " (cast (bitcast bytes u32) i64) "\n")
      (output (cast (bitcast (: (vec 255 255) <vec u8 2>) i16) i64) "\n")
      (var narrow = (: -2 i32))
      (output (bitcast narrow <vec i16 2>) " " (bitcast (: 513 u16) <vec u8 2>) "\n")
      (var wide = (bitcast (: (vec 5 7) <vec i64 2>) i128))
      (output (cast wide i64) " " (cast (>> wide (: 64 i128)) i64) "\n")
      (output (bitcast wide <vec u32 4>) " " (bitcast (: -3 i128) <vec i64 2>) "\n")
      (var lanes = (vec 1.0 -2.0))
      (output (bitcast lanes <vec i64 2>) " " (bitcast pair <vec i16 4>) "\n")
      (var mask = (< (: (vec 1 5 3 7 0 9 2 8) <vec i8 8>) (: 4 i8)))
      (output (bitcast mask <vec u8 8>) " " (bitcast mask i64) "\n"))))
