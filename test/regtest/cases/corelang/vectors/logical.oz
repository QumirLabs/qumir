(block
  (use Vector)
  (fun <main> ()
    (block
      (var a = (: (vec -128 -1 0 127) <vec i8 4>))
      (var b = (: (vec 127 -1 -1 127) <vec i8 4>))
      (output (< a b) "\n" (<= a b) "\n" (> a b) "\n" (>= a b) "\n")
      (output (== a b) "\n" (!= a b) "\n" (< 0 a) "\n")
      (output (== a (vec -128 -1 0 127)) "\n")
      (output (< a (vec -1.5 0.0 0.5 128.0)) "\n")
      (var u = (: (vec 0 255 128 127) <vec u8 4>))
      (output (> u 127) "\n" (== u 255) "\n")
      (var f = (vec -1.5 0.0 2.5 3.0))
      (output (< f 1.0) "\n" (! f) "\n" (! a) "\n")
      (output (&& a b) "\n" (|| a b) "\n" (&& f #t) "\n" (|| #f f) "\n")
      (var integer = 256)
      (var fraction = 0.5)
      (output (&& a integer) "\n" (&& fraction f) "\n")
      (var integerMask = (cast integer bool))
      (var fractionMask = (cast fraction bool))
      (output (&& a integerMask) "\n" (&& fractionMask f) "\n")
      (output (== integerMask #t) " " (== fractionMask #t) "\n")
      (var nan = (bitcast -1 f64))
      (var nanMask = (cast nan bool))
      (output (&& (vec #t #f) nanMask) " " (== nanMask #t) "\n")
      (var zero = -0.0)
      (output (! zero) " " (! fraction) " " (! nan) " " (! (vec zero fraction)) "\n")
      (var calls = 0)
      (output (&& (vec #f #f) (block (= calls (+ calls 1)) (vec #t #t))) " " calls "\n")
      (output (|| (vec #t #t) (block (= calls (+ calls 1)) (vec #f #f))) " " calls "\n")
      (output (&& #f (block (= calls (+ calls 1)) #t)) " " calls "\n")
      (output (|| #t (block (= calls (+ calls 1)) #f)) " " calls "\n")
      (var masks = (vec #t #f #f #t))
      (output (! masks) "\n" (== masks #f) "\n" (< masks #t) "\n"))))
