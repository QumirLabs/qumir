(block
  (fun <main> ()
    (block
      (var ints = (call array_create 32))
      (var p = (bitcast ints <ptr i32>))
      (var floats = (call array_create 32))
      (var q = (bitcast floats <ptr f64>))
      (var i = 0)
      (while (< i 8)
        (block (= p [i] (cast (* i 10) i32)) (= i (+ i 1))))
      (= i 0)
      (while (< i 4)
        (block (= q [i] (+ (cast i f64) 0.5)) (= i (+ i 1))))
      (var a = (call builtin::gather p (vec 7 0 5 2)))
      (output (index a 0) " " (index a 1) " " (index a 2) " " (index a 3) "\n")
      (var lanes = (: (vec 3 1 0 2) <vec u8 4>))
      (var b = (call builtin::gather q lanes))
      (output (index b 0) " " (index b 1) " " (index b 2) " " (index b 3) "\n")
      (var c = (call builtin::gather p (+ lanes lanes)))
      (output (index c 0) " " (index c 1) " " (index c 2) " " (index c 3) "\n")
      (call array_destroy floats)
      (call array_destroy ints))))
